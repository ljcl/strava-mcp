# Strava OAuth credentials (from strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public URL for OAuth callback (e.g., https://strava-mcp.coelacanth-tuna.ts.net)
# Required for web-based OAuth flow
PUBLIC_URL=

# Optional: Initial tokens from `cd apps/server && bun run setup-auth` (not needed if using web auth)
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Optional: Shared secret gating /mcp and the OAuth web routes.
# Strongly recommended when the server is exposed through a tunnel — without it
# anyone who finds the URL can read your data and use the write tools.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: Path for exported routes
ROUTE_EXPORT_PATH=

# Optional: Override token storage directory (default: ./data)
TOKEN_DATA_DIR=
